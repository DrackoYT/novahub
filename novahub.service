# Servicio de usuario de systemd para NovaHub.
#   mkdir -p ~/.config/systemd/user && cp novahub.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now novahub
#   sudo loginctl enable-linger $USER   # para que arranque con el servidor sin iniciar sesión
[Unit]
Description=NovaHub - panel de servicios
After=network-online.target

[Service]
# NovaHub avisa a systemd cuando está listo y cada 10 s mientras todo responde;
# si se queda colgado más de 30 s, systemd lo reinicia (los servicios no se tocan).
Type=notify
NotifyAccess=main
WatchdogSec=30
# Ajusta la ruta si clonaste NovaHub en otra carpeta.
WorkingDirectory=%h/projectes/novahub
ExecStart=/usr/bin/python3 %h/projectes/novahub/server.py
Environment=NOVAHUB_HOST=127.0.0.1
Environment=NOVAHUB_PORT=8686
# Activa «Publicar en internet» en el panel (ver README):
#Environment=NOVAHUB_DOMAIN=tudominio.com
Restart=on-failure
RestartSec=3
# Solo se mata al panel al pararlo/reiniciarlo: los servicios que gestiona siguen vivos.
KillMode=process

[Install]
WantedBy=default.target
